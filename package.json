{
  "name": "hkust-life-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Source-grounded HKUST Clear Water Bay student-life MCP server",
  "type": "module",
  "workspaces": [
    "apps/hub",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hkust-life-mcp": "dist/index.js"
  },
  "scripts": {
    "api": "CAMPUS_MODE=local-development tsx src/product/main.ts",
    "api:seed": "CAMPUS_MODE=local-development tsx src/product/seed-cli.ts",
    "mobile": "npm --workspace @campus/mobile run start",
    "build": "npm run build:hub",
    "build:core": "tsc -p tsconfig.json",
    "build:hub": "npm run build:core && npm --prefix apps/hub run build",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/index.ts",
    "http": "tsx src/http.ts",
    "hub": "npm --prefix apps/hub run dev",
    "test": "npm run build:core && vitest run",
    "smoke": "npm run build && node scripts/smoke-mcp.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.12.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}

{
  "expo": {
    "name": "Campus · 开发版",
    "slug": "hkust-campus-local",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "local.hkustcampus.development",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "./plugins/with-ios-scene.cjs",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "USTLIFE 今天",
              "description": "今天的截止和下一班校巴",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ],
      "expo-maps"
    ]
  }
}

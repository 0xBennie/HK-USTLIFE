{
  "name": "@campus/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "bundle:ios": "expo export --platform ios --output-dir dist",
    "start:device": "node scripts/device-check.mjs && expo start --dev-client --lan",
    "device:check": "node scripts/device-check.mjs",
    "eas:login": "npx --yes eas-cli@24.10.0 login --browser",
    "eas:whoami": "npx --yes eas-cli@24.10.0 whoami",
    "eas:init": "npx --yes eas-cli@24.10.0 init",
    "eas:device": "npx --yes eas-cli@24.10.0 device:create",
    "build:ios:cloud": "npx --yes eas-cli@24.10.0 build --platform ios --profile development"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.26",
    "expo-blur": "57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "heroui-native": "1.0.10",
    "lucide-react-native": "1.51.0",
    "number-flow-react-native": "^0.5.1",
    "pressto": "^0.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "6.0.3"
  }
}
